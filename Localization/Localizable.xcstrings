            "state": "translated",
            "value": "Wine et Game Porting Toolkit"
          }
        }
      }
    },
    "Words passed to the game when it starts. Quote a word with spaces.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mots transmis au jeu à son lancement. Mettez entre guillemets un mot qui contient des espaces."
