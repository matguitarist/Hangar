            "value": "Version inconnue"
          }
        }
      }
    },
    "What Hangar does, such as finding and launching games, is written here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que fait Hangar, comme trouver et lancer des jeux, est écrit ici."
          }
        }
      }
    },
    "What runs this game": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui lance ce jeu"
          }
        }
      }
    },
    "What runs your Windows games. Hangar finds them in the Applications folders and Homebrew.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui lance vos jeux Windows. Hangar les trouve dans les dossiers Applications et dans Homebrew."
          }
        }
      }
    },
