    },
    "Done": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé"
          }
        }
      }
    },
    "Drag games here to add them": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez des jeux ici pour les ajouter"
          }
        }
      }
    },
    "Draws the game at the full resolution of a Retina display. Demanding games run slower.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le jeu à la pleine résolution d’un écran Retina. Les jeux exigeants ralentissent."
          }
        }
      }
    },
    "Faster syncing between the game's threads. Most games run better with it on.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation plus rapide entre les fils d’exécution du jeu. La plupart des jeux tournent mieux avec cette option."
          }
        }
      }
    },
    "File:": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier :"
          }
        }
      }
    },
