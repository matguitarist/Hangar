      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CrossOver"
          }
        }
      }
    },
    "CrossOver has no bottles. Make one in CrossOver first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CrossOver n’a aucune bouteille. Créez-en une dans CrossOver d’abord."
          }
        }
      }
    },
    "CrossOver isn't installed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CrossOver n’est pas installé."
          }
        }
      }
    },
    "CrossOver isn't installed. Hangar needs it to play the Windows games in your bottles.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CrossOver n’est pas installé. Hangar en a besoin pour lancer les jeux Windows de vos bouteilles."
          }
        }
      }
    },
    "CrossOver, bottle %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CrossOver, bouteille %@"
          }
        }
      }
    },
    "Delete Collection": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer la collection"
          }
        }
      }
    },
    "Did %@ run well?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a-t-il bien fonctionné ?"
          }
        }
      }
    },
    "Dismiss": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer"
          }
        }
      }
    },
    "Doesn't run": {
