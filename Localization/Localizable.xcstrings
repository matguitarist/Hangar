        }
      }
    },
    "Every game on this Mac in one library: Mac games, and Windows games that run through CrossOver and other runners. Hangar finds them, launches them, and keeps their settings and saves safe.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les jeux de ce Mac dans une seule bibliothèque : les jeux Mac, et les jeux Windows qui s’exécutent dans CrossOver et d’autres lanceurs. Hangar les trouve, les lance, et garde leurs réglages et leurs sauvegardes en sécurité."
          }
        }
      }
    },
    "Focus": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentration"
          }
        }
      }
    },
