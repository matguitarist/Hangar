        }
      }
    },
    "CrossOver isn't installed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CrossOver n’est pas installé."
          }
        }
      }
    },
    "CrossOver isn't installed. Hangar needs it to play the Windows games in your bottles.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CrossOver n’est pas installé. Hangar en a besoin pour lancer les jeux Windows de vos bouteilles."
          }
        }
      }
    },
