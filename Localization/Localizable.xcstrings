        }
      }
    },
    "Games you remove stay on disk. Restore one to see it in the library again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jeux retirés restent sur le disque. Rétablissez-en un pour le revoir dans la bibliothèque."
          }
        }
      }
    },
