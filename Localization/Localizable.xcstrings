    "CrossOver has no bottles. Make one in CrossOver first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CrossOver n’a aucune bouteille. Créez-en une dans CrossOver d’abord."
