        }
      }
    },
    "A store sells a version for macOS. How well it runs isn't rated.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un magasin vend une version pour macOS. Son fonctionnement n’est pas évalué."
