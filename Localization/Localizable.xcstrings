{
  "sourceLanguage": "en",
  "strings": {
    "%@ (shortcut)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (raccourci)"
          }
        }
      }
    },
    "%@ also run in this bottle. These settings change them too.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’exécutent aussi dans cette bouteille. Ces réglages les changent aussi."
          }
        }
      }
    },
    "%@ also runs in this bottle. These settings change it too.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’exécute aussi dans cette bouteille. Ces réglages le changent aussi."
          }
        }
      }
    },
    "%@ didn't start. %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas démarré. %@"
          }
        }
      }
    },
    "%@ is running": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en cours"
          }
        }
      }
    },
    "%@ quit": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’est fermé"
          }
        }
      }
    },
    "%@ quit right away": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’est fermé aussitôt"
          }
        }
      }
    },
    "%@ quit: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’est fermé : %@"
          }
        }
      }
    },
    "%@ updated from %@ to %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est passé de %2$@ à %3$@"
          }
        }
      }
    },
    "%@'s settings and bottle files go back to how they were. Hangar saves the current ones first, so you can come back.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages et les fichiers de bouteille de %@ reviennent à leur état d’alors. Hangar enregistre d’abord les actuels, pour que vous puissiez y revenir."
          }
        }
      }
    },
    "%@, playing for %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, partie en cours depuis %@"
          }
        }
      }
    },
